# 复制为 .env 后按需修改。所有设置均为可选。

# 时区，用于测量时间与每周分析计划。
TZ=Asia/Taipei

# 指定体脂秤地址，可在 /api/debug/devices 查看。留空接收附近支持的体脂秤。
MISCALE_SCALE_MAC=

# 通知语言：zh-CN、en 或 pt-BR。网页默认简体中文，可在设置中切换。
MISCALE_LANG=zh-CN

# 通知中附带的看板链接。
MISCALE_PUBLIC_URL=

# 每次称重后的通知。可设置 JSON webhook 或 Telegram，默认均关闭。
MISCALE_WEBHOOK_URL=
# 从 @BotFather 获取机器人令牌，再填写接收消息的聊天 ID。
MISCALE_TELEGRAM_TOKEN=
MISCALE_TELEGRAM_CHAT_ID=

# AI 每周分析默认关闭。配置密钥或启用本地服务后才发送数据。
# 支持 OpenAI 兼容接口。外部服务会收到称重数据和用户资料，详见 README。
MISCALE_AI_API_KEY=
# 例如 https://api.openai.com/v1、https://openrouter.ai/api/v1 或本地 Ollama 地址。
MISCALE_AI_BASE_URL=
# 模型名称；多个模型用逗号分隔，依次尝试。留空使用上游默认模型。
MISCALE_AI_MODEL=
# 无需密钥的本地服务（如 Ollama）：设为 true。
MISCALE_AI_ENABLED=
# 每周分析时间。0 为周一，6 为周日；默认周六 09:00。
MISCALE_AI_WEEKDAY=5
MISCALE_AI_HOUR=9
# 分析语言：zh-CN、en 或 pt-BR。留空跟随 MISCALE_LANG。
MISCALE_AI_LANG=

# 先以 off 启动，确认体脂秤型号与蓝牙权限后改为 on，并重启服务。
MISCALE_SCANNER=off
